{
  "name": "howbeam-extension",
  "description": "Record clicks and generate step-by-step annotated image guides",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "wxt build && playwright test",
    "test:e2e:headed": "wxt build && PW_HEADED=1 playwright test",
    "test:all": "vitest run && wxt build && playwright test",
    "postinstall": "wxt prepare",
    "validate:artifacts": "node tests/build/validate-browser-artifacts.mjs",
    "lint:firefox": "node tests/build/validate-firefox-lint.mjs",
    "test:e2e:firefox": "wxt build -b firefox && node tests/e2e/firefox-smoke.mjs",
    "test:e2e:browsers": "wxt build && playwright test && wxt build -b firefox && node tests/e2e/firefox-smoke.mjs",
    "test:e2e:docker": "docker build -f Dockerfile.e2e -t howbeam-extension-e2e . && mkdir -p test-results && docker run --rm --init --ipc=host -v \"$PWD/test-results:/work/extension/test-results\" howbeam-extension-e2e",
    "fonts:pdf": "python scripts/pdf-fonts/build.py",
    "validate:architecture": "node tests/build/validate-module-boundaries.mjs",
    "validate": "tsc --noEmit && eslint . --max-warnings 0 && node tests/build/validate-module-boundaries.mjs && vitest run && wxt build && wxt build -b firefox && node tests/build/validate-browser-artifacts.mjs && node tests/build/validate-firefox-lint.mjs",
    "benchmark:detection": "wxt build && playwright test -c playwright.benchmark.config.ts",
    "benchmark:detection:update-baseline": "HOWBEAM_BENCHMARK_UPDATE=1 pnpm benchmark:detection"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "lucide-react": "^1.61.0",
    "pdfkit": "^0.20.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/fontkit": "^2.0.9",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^6.1.1",
    "fake-indexeddb": "^6.2.6",
    "fontkit": "^2.0.4",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "pdfjs-dist": "^6.4.299",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12",
    "web-ext": "10.8.0",
    "wxt": "^0.21.4"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24.22.1"
  }
}
