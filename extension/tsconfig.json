{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    // WXT's generated .wxt/tsconfig.json declares these aliases relative to
    // .wxt/, which the shadcn CLI resolves against this file instead and so
    // writes components outside the project. Restating them from the project
    // root keeps `npx shadcn add` and TypeScript in agreement; Vite's aliases
    // come from wxt.config, so the build is unaffected.
    "baseUrl": ".",
    "paths": {
      "@": ["."],
      "@/*": ["./*"],
      "~": ["."],
      "~/*": ["./*"],
      "@@": ["."],
      "@@/*": ["./*"],
      "~~": ["."],
      "~~/*": ["./*"]
    },
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedSideEffectImports": true,
    // WXT 0.21 turned this on in its generated base; the code was written
    // without it, so adopting it is its own change, not part of a WXT upgrade.
    "noUncheckedIndexedAccess": false
  }
}
